# Copy to .env.local and fill in values. Do not commit .env.local.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ThePool

# Session signing — generate with: openssl rand -base64 32
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: force pool week (integer) instead of automatic detection
# POOL_ACTIVE_WEEK=

# Site credentials are stored in public."Players":
#   Player_Username, Player_Password_Hash (bcrypt)
# Set a password: node scripts/set-player-password.mjs <username> <password> [displayName] [email]
