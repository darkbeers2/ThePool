# Copy to .env.local on the droplet:
#   cp deploy/env.production.example .env.local
#   nano .env.local

NODE_ENV=production
PORT=3000

# PostgreSQL on this droplet (adjust user/password/host/db as needed)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/ThePool

# Canonical site URL (required in production behind Apache)
AUTH_URL=https://www.atsoverunder.com

# Generate on the droplet:
#   openssl rand -base64 32
AUTH_SECRET=PASTE_GENERATED_SECRET_HERE
AUTH_TRUST_HOST=true

# Google OAuth — add this redirect URI in Google Cloud Console:
#   https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: force active week for testing
# POOL_ACTIVE_WEEK=
